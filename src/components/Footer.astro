---
// サイトフッター
const base = import.meta.env.BASE_URL;
---

<footer data-pagefind-ignore>
  <p>&copy; 2000–2026 ゆうやみ &nbsp;/&nbsp; u83 said so.</p>
  <p><a href={`${base}sitemap/`}>サイトマップ</a></p>
</footer>

<style>
  footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    text-align: center;
    padding: 24px;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  footer a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
